# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/resume_analyzer

# ─── AI Provider ───────────────────────────────────────────────────────────────
# Set the provider you want to use: "gemini" | "openai" | "zhipu"
# 
# RECOMMENDATION BY REGION:
#   Mainland China (no VPN): use "zhipu"  → https://open.bigmodel.cn (free tier available)
#   Outside China:           use "gemini" → https://aistudio.google.com/apikey (free tier)
#   Any region (paid):       use "openai" → https://platform.openai.com
#
AI_PROVIDER=gemini

# Google Gemini — free tier, requires VPN in mainland China
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI — paid, works globally with VPN
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Zhipu AI (智谱AI / GLM) — works in mainland China without VPN, free tier available
# Register at: https://open.bigmodel.cn → API Keys → Create
# Free quota: 1M tokens on registration
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_MODEL=glm-4-flash

# ─── File Upload ───────────────────────────────────────────────────────────────
# Local dev: ./uploads | Render.com (free tier): /tmp/uploads
# Render's free tier has ephemeral disk — /tmp persists within an instance session
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_BATCH=10

# ─── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
