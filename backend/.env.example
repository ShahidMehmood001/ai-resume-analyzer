# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/resume_analyzer

# ─── AI Provider ───────────────────────────────────────────────────────────────
# Set the provider you want to use: "gemini" | "openai"
AI_PROVIDER=gemini

# Google Gemini (free tier available: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (alternative — set AI_PROVIDER=openai and fill this)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ─── File Upload ───────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_BATCH=10

# ─── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
